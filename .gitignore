# Release allowlist: retain local research material without publishing it.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.zh-CN.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CITATION.cff
!/SECURITY.md
!/CHANGELOG.md
!/RELEASE_NOTES.md
!/pyproject.toml
!/uv.lock
!/benchmark/
!/method/
!/construction/

__pycache__/
*.py[cod]
.pytest_cache/
/construction/.env
/construction/.venv/
/construction/variants/
/construction/clean_mcp/
/construction/real_mcp/
/construction/ground_truth/
/construction/mcp_dataset/
/construction/benign_mcp/
/construction/interaction_logs/
/construction/inputs/
/construction/*/*_data_seed/
