    "demo": "node scripts/demo-ops-summary.js",
    "check": "node scripts/check-syntax.js",
    "smoke": "node scripts/smoke-tools.js"
  },
  "keywords": [
    "jobber",
    "mcp",
    "field-service",
    "operations"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
