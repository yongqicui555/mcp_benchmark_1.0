{
  "name": "@opsconduit/jobber-mcp",
  "version": "0.1.3",
  "description": "Customer-hosted MCP server for read-only Jobber operations queries.",
  "type": "module",
  "mcpName": "io.github.opsconduit/jobber-mcp",
  "homepage": "https://opsconduit.github.io/jobber-mcp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsconduit/jobber-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/opsconduit/jobber-mcp/issues"
  },
  "bin": {
    "opsconduit-jobber-auth": "src/oauth-local.js",
    "opsconduit-jobber-mcp": "src/server.js"
  },
  "files": [
    ".env.example",
    "LICENSE",
    "README.md",
    "docs/",
    "examples/",
    "glama.json",
    "scripts/",
    "server.json",
    "src/"
  ],
  "publishConfig": {
