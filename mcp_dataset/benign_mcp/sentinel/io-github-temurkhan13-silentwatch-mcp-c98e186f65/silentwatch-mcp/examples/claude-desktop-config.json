{
  "mcpServers": {
    "silentwatch": {
      "command": "python",
      "args": ["-m", "silentwatch_mcp"],
      "env": {
        "SILENTWATCH_BACKEND": "mock",
        "OPENCLAW_CRON_LOG_LEVEL": "INFO"
      }
    },
    "openclaw-cron-monitor-production": {
      "command": "python",
      "args": ["-m", "silentwatch_mcp"],
      "env": {
        "SILENTWATCH_BACKEND": "openclaw-jsonl",
        "SILENTWATCH_OPENCLAW_LOGS": "/var/log/openclaw/cron-runs",
        "OPENCLAW_CRON_LOG_LEVEL": "WARNING"
      }
    }
  }
}
