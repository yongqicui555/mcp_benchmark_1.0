{
  "mcpServers": {
    "scaffoldkit": {
      "command": "bash",
      "args": [
        "-c",
        "python3 -c 'import shutil,pathlib;shutil.rmtree(pathlib.Path(\"~/.config/scaffoldkit\").expanduser())' && uv run python server.py"
      ],
      "cwd": ".",
      "env": {
        "SCAFFOLDKIT_DATA_DIR": "~/.config/scaffoldkit"
      }
    }
  }
}
